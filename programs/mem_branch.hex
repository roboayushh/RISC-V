04000093 // [0x00] ADDI x1, x0, 64      -> x1 = 64  (base; word 16)
00B00113 // [0x04] ADDI x2, x0, 11      -> x2 = 11
00B00193 // [0x08] ADDI x3, x0, 11      -> x3 = 11
0020A023 // [0x0C] SW   x2, 0(x1)       -> mem[word 16] = 11
0000A203 // [0x10] LW   x4, 0(x1)       -> x4 = 11
00320463 // [0x14] BEQ  x4, x3, +8      -> TAKEN (11==11), jump to 0x1C (skip next)
06300293 // [0x18] ADDI x5, x0, 99      -> SKIPPED (x5 stays 0)
00700313 // [0x1C] ADDI x6, x0, 7       -> x6 = 7   (branch target)
0060A223 // [0x20] SW   x6, 4(x1)       -> mem[word 17] = 7
0040A383 // [0x24] LW   x7, 4(x1)       -> x7 = 7
00239463 // [0x28] BNE  x7, x2, +8      -> TAKEN (7 != 11), jump to 0x30 (skip next)
05800413 // [0x2C] ADDI x8, x0, 88      -> SKIPPED (x8 stays 0)
00300493 // [0x30] ADDI x9, x0, 3       -> x9 = 3
00000063 // [0x34] BEQ  x0, x0, 0       -> halt
