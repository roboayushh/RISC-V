04000093 // [0x00] ADDI x1, x0, 64      -> x1 = 64  (base; word 16)
00000113 // [0x04] ADDI x2, x0, 0       -> x2 = 0    (zero value)
0020A023 // [0x08] SW   x2, 0(x1)       -> mem[word 16] = 0        (store zero)
0000A183 // [0x0C] LW   x3, 0(x1)       -> x3 = 0                  (load zero back, consecutive)
FFF00393 // [0x10] ADDI x7, x0, -1      -> x7 = 0xFFFFFFFF (all 32 bits set; large value)
0070A423 // [0x14] SW   x7, 8(x1)       -> mem[word 18] = 0xFFFFFFFF (addr 72, +8 offset)
0080A403 // [0x18] LW   x8, 8(x1)       -> x8 = 0xFFFFFFFF          (consecutive load)
FE70AE23 // [0x1C] SW   x7, -4(x1)      -> mem[word 15] = 0xFFFFFFFF (addr 60, NEGATIVE offset -4)
FFC0A483 // [0x20] LW   x9, -4(x1)      -> x9 = 0xFFFFFFFF          (negative-offset load)
00000063 // [0x24] BEQ  x0, x0, 0       -> halt
