04000093 // [0x00] ADDI x1, x0, 64      -> x1 = 64   (base address, byte addr 64 = word 16)
01900113 // [0x04] ADDI x2, x0, 25      -> x2 = 25   (value to store)
0020A023 // [0x08] SW   x2, 0(x1)       -> mem[word 16] = 25   (addr = 64+0 = 64)
0000A183 // [0x0C] LW   x3, 0(x1)       -> x3 = mem[word 16] = 25
00310233 // [0x10] ADD  x4, x2, x3      -> x4 = 25 + 25 = 50
00000063 // [0x14] BEQ  x0, x0, 0       -> halt (branch-to-self, PC stuck)
